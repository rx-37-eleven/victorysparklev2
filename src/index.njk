---
layout: base.njk
title: Home
description: Hi, I'm Ryen — welcome to Victory Sparkle Co. Free browser tools for makers, one-of-a-kind art and patterns, and the latest from the blog.
permalink: /
---
<section class="home-hero">
    <div class="home-hero-sparkles" aria-hidden="true">
        <span class="sparkle" style="left:6%;top:18%;font-size:26px;color:var(--color-accent-pink);animation-delay:0s">&#10022;</span>
        <span class="sparkle" style="left:88%;top:8%;font-size:20px;color:var(--color-accent-teal);animation-delay:1.1s">&#10022;</span>
        <span class="sparkle" style="left:72%;top:52%;font-size:30px;color:var(--color-surface-lavender);animation-delay:.5s">&#10022;</span>
        <span class="sparkle" style="left:44%;top:4%;font-size:16px;color:var(--color-accent-teal);animation-delay:1.8s">&#10022;</span>
        <span class="sparkle" style="left:94%;top:38%;font-size:22px;color:var(--color-accent-pink);animation-delay:2.4s">&#10022;</span>
        <span class="sparkle" style="left:22%;top:64%;font-size:18px;color:var(--color-shadow);animation-delay:1.4s">&#10022;</span>
        <span class="sparkle" style="left:10%;top:4%;font-size:20px;color:var(--color-primary);animation-delay:2s">&#10022;</span>
        <span class="sparkle" style="left:58%;top:20%;font-size:14px;color:var(--color-accent-pink);animation-delay:1.5s">&#10022;</span>
        <span class="sparkle" style="left:34%;top:76%;font-size:24px;color:var(--color-accent-teal);animation-delay:.9s">&#10022;</span>
        <span class="sparkle" style="left:80%;top:70%;font-size:18px;color:var(--color-shadow);animation-delay:2.8s">&#10022;</span>
        <span class="sparkle" style="left:2%;top:74%;font-size:16px;color:var(--color-surface-lavender);animation-delay:.3s">&#10022;</span>
        <span class="sparkle" style="left:64%;top:36%;font-size:15px;color:var(--color-primary);animation-delay:3.1s">&#10022;</span>
    </div>
    <p class="home-kicker">hello, hello</p>
    <h1 class="home-hero-title">Nice to meet you!</h1>
    <p class="home-hero-subtitle">I'm so glad to connect. Please check out my shop &amp; my free resources and tools!</p>
    <div class="home-hero-actions">
        <a href="https://ko-fi.com/victorysparkle" target="_blank" rel="noopener noreferrer" class="home-btn home-btn-pink">Visit the shop <span class="home-btn-arrow">&rarr;</span></a>
        <a href="/resources/" class="home-btn home-btn-mint">Free tools &amp; resources</a>
    </div>
</section>

<section class="home-card home-about">
    <div class="home-about-media">
        <div class="home-about-frame" aria-hidden="true"></div>
        <div class="home-about-image">
            {% image "/images/home/portrait.jpg", "Portrait of Ryen", "(max-width: 700px) 100vw, 480px", "home-about-photo" %}
        </div>
    </div>
    <div class="home-about-copy">
        <p class="home-kicker home-kicker-pink">about me</p>
        <h2 class="home-h2">Hi there! I'm Ryen &ndash; Artist, Maker, Computer Geek, and Traveler.</h2>
        <div class="home-trait-pills">
            <span class="home-trait-pill home-trait-lavender">Artist</span>
            <span class="home-trait-pill home-trait-pink">Maker</span>
            <span class="home-trait-pill home-trait-mint">Computer Geek</span>
            <span class="home-trait-pill home-trait-cream">Traveler</span>
        </div>
        <a href="/about/" class="home-text-link">More about me &rarr;</a>
    </div>
</section>

<section class="home-carousel-section">
    <div class="home-section-heading">
        <div>
            <p class="home-kicker">a look around</p>
            <h2 class="home-h2 home-h2-lg">Making, going, showing</h2>
        </div>
        <div class="home-carousel-controls">
            <button type="button" class="home-carousel-btn" data-carousel-prev aria-label="Previous photo">&larr;</button>
            <button type="button" class="home-carousel-btn home-carousel-btn-next" data-carousel-next aria-label="Next photo">&rarr;</button>
        </div>
    </div>

    <div class="home-carousel">
        <div class="home-carousel-track" data-carousel-track>
            <div class="home-carousel-slide" data-caption="Finished craft projects">
                {% image "/images/home/slide-1.jpg", "Finished craft project", "100vw", "home-carousel-photo" %}
            </div>
            <div class="home-carousel-slide" data-caption="Work in progress">
                {% image "/images/home/slide-2.jpg", "Work in progress", "100vw", "home-carousel-photo" %}
            </div>
            <div class="home-carousel-slide" data-caption="Events &amp; booths">
                {% image "/images/home/slide-3.jpg", "Event booth", "100vw", "home-carousel-photo" %}
            </div>
            <div class="home-carousel-slide" data-caption="Travel">
                {% image "/images/home/slide-4.jpg", "Travel photo", "100vw", "home-carousel-photo" %}
            </div>
            <div class="home-carousel-slide" data-caption="Me">
                {% image "/images/home/slide-5.jpg", "A photo of me", "100vw", "home-carousel-photo" %}
            </div>
        </div>
        <div class="home-carousel-caption" data-carousel-caption>Finished craft projects</div>
    </div>

    <div class="home-carousel-dots" data-carousel-dots>
        <button type="button" class="home-carousel-dot is-active" data-carousel-goto="0" aria-label="Photo 1"></button>
        <button type="button" class="home-carousel-dot" data-carousel-goto="1" aria-label="Photo 2"></button>
        <button type="button" class="home-carousel-dot" data-carousel-goto="2" aria-label="Photo 3"></button>
        <button type="button" class="home-carousel-dot" data-carousel-goto="3" aria-label="Photo 4"></button>
        <button type="button" class="home-carousel-dot" data-carousel-goto="4" aria-label="Photo 5"></button>
    </div>
</section>

<section class="home-features">
    <a href="https://ko-fi.com/victorysparkle" target="_blank" rel="noopener noreferrer" class="home-feature-card home-feature-shop">
        <div>
            <p class="home-kicker home-kicker-pink">the shop</p>
            <h2 class="home-h2">Stained glass patterns, sewing patterns, one of a kind artwork</h2>
        </div>
        <span class="home-feature-cta">Browse on Ko-fi &rarr;</span>
    </a>
    <a href="/blog/" class="home-feature-card home-feature-blog">
        <div>
            <p class="home-kicker">latest from the blog</p>
            {% if blogposts.length %}
            <p class="home-feature-mono">{{ blogposts[0].title or (blogposts[0].publishedAt | postDate) }}</p>
            {% if blogposts[0].excerpt %}<p class="home-feature-mono home-feature-mono-muted">{{ blogposts[0].excerpt }}</p>{% endif %}
            {% else %}
            <p class="home-feature-mono home-feature-mono-muted">No posts yet &#10022; &mdash; check back soon.</p>
            {% endif %}
        </div>
        <span class="home-feature-cta home-feature-cta-link">Read the blog &rarr;</span>
    </a>
</section>

<section class="content-section home-pinterest" id="pinterest">
    <h2 class="home-h2">Current Inspiration</h2>
    <!-- Pinterest board embed-->
    <a data-pin-do="embedBoard"
       data-pin-board-width="1080"
       data-pin-scale-height="320"
       data-pin-scale-width="115"
       href="https://www.pinterest.com/victorysparkle/website-board/"></a>
</section>

<div class="home-shop-tab" id="home-shop-tab">
    <a href="https://ko-fi.com/victorysparkle" target="_blank" rel="noopener noreferrer" class="home-shop-tab-link">
        <span class="home-shop-tab-label">shop</span>
        <span>Patterns &amp; original art &rarr;</span>
    </a>
    <button type="button" class="home-shop-tab-dismiss" id="home-shop-tab-dismiss" aria-label="Dismiss shop notice">&#10005;</button>
</div>

<script src="/js/landing.js" defer></script>
