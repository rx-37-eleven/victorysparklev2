<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&family=DynaPuff:wght@400..700&family=Miniver&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon.png">
    <link rel="alternate" type="application/rss+xml" title="Victory Sparkle Co. Blog" href="/blog/feed.xml">
    {% set pageTitle = (title + " · " + site.name) if title else site.name %}
    {% set pageDescription = description if description else site.description %}
    {% set pageImage = site.url + (ogImage if ogImage else site.defaultOgImage) %}
    {% set pageUrl = site.url + page.url %}

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="{{ pageUrl }}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:image" content="{{ pageImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ ogImageAlt if ogImageAlt else site.name }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ pageImage }}">

    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header data-pagefind-ignore>
        <div class="header-content">
            <a href="/" class="logo-section" aria-label="Victory Sparkle Co. home">
                <div class="profile-image"><img src="/images/Vlogo.png" alt=""></div>
                <div class="site-title">Victory Sparkle Co.</div>
            </a>
            <button type="button" class="nav-toggle" id="nav-toggle"
                    aria-expanded="false" aria-controls="main-nav" aria-label="Menu">
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
            </button>
            <nav class="main-nav" id="main-nav">
                <div class="nav-item">
                    <button type="button" class="nav-trigger" aria-expanded="false">Make</button>
                    <div class="nav-dropdown">
                        <a href="/apps/pinpress/">Pinpress</a>
                        <a href="/apps/tilemaker/">Seamless Tile Maker</a>
                        <a href="/apps/stained-glass-vectorizer/">Stained Glass Vectorizer</a>
                        <a href="/apps/weedline/">Weedline</a>
                        <a href="/resources/">Resources</a>
                        <a href="https://www.pinterest.com/victorysparkle/website-board/" target="_blank" rel="noopener noreferrer">Pinterest</a>
                    </div>
                </div>
                <div class="nav-item">
                    <button type="button" class="nav-trigger" aria-expanded="false">Code</button>
                    <div class="nav-dropdown">
                        <a href="/code/">Telegram Bots</a>
                    </div>
                </div>
                <div class="nav-item">
                    <button type="button" class="nav-trigger" aria-expanded="false">About</button>
                    <div class="nav-dropdown">
                        <a href="/events/">Events</a>
                        <a href="/about/">About</a>
                        <a href="/blog/">Blog</a>
                        <a href="/map/">Travel Map</a>
                        <a href="/contact/">Contact</a>
                    </div>
                </div>
                <a href="/search/" class="nav-search-link">Search</a>
                <a href="https://ko-fi.com/victorysparkle" target="_blank" rel="noopener noreferrer" class="nav-shop-link">Shop</a>
            </nav>
        </div>
    </header>

    <main data-pagefind-body>
        {{ content | safe }}
    </main>

    <footer data-pagefind-ignore>
        <div class="footer-content">
            <p>&copy; {{ site.buildYear }} {{ site.name }} All rights reserved.</p>
            <div class="footer-links">
                <a href="/apps/pinpress/">Pinpress</a>
                <a href="/apps/tilemaker/">Seamless Tile Maker</a>
                <a href="/apps/stained-glass-vectorizer/">Stained Glass Vectorizer</a>
                <a href="/code/">Telegram Bots</a>
                <a href="/apps/weedline/">Weedline</a>
                <a href="/resources/">Resources</a>
                <a href="/map/">Travel Map</a>
                <a href="/blog/">Blog</a>
                <a href="/events/">Events</a>
                <a href="/about/">About</a>
                <a href="/search/">Search</a>
                <a href="/contact/">Contact</a>
            </div>
            <div><br> <p><em>Semper Desiderari, Princess Sandy</em></p></div>
        </div>
    </footer>
    <script async defer src="//assets.pinterest.com/js/pinit.js"></script>
    <script src="/js/nav.js" defer></script>
</body>
</html>
