---
layout: base.njk
title: Blog
description: "Updates from Victory Sparkle Co., posted straight from Telegram."
pagination:
  data: blogpostsForPagination
  size: 20
  alias: posts
permalink: "{% if pagination.pageNumber == 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<div class="content-section blog-page">
  <h1>Blog</h1>
  <p>Updates from Victory Sparkle Co., posted straight from Telegram.</p>

  {% if posts[0].__empty %}
  <p class="blog-status">No posts yet ✨ — check back soon.</p>
  {% else %}
  <div class="blog-list">
    {% for post in posts %}
    <article class="blog-list-item">
      <h2 class="blog-list-title">
        <a href="{{ post.url }}">{{ post.title or (post.publishedAt | postDate) }}</a>
      </h2>
      <time class="blog-list-date" datetime="{{ post.publishedAt | postDateISO }}">{{ post.publishedAt | postDate }}</time>
      <div class="blog-post-body">{{ post.bodyHtml | safe }}</div>
    </article>
    {% endfor %}
  </div>

  {% if pagination.href.previous or pagination.href.next %}
  <nav class="blog-pager">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}" class="blog-pager-link">&larr; Newer posts</a>{% endif %}
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}" class="blog-pager-link">Older posts &rarr;</a>{% endif %}
  </nav>
  {% endif %}
  {% endif %}
</div>
