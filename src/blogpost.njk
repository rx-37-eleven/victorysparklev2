{% set post = pagination.items[0] %}
<div class="content-section blog-page">
  <a href="/blog/" class="blog-back-link">&larr; Back to blog</a>
  <article class="blog-post">
    <h1><a href="{{ post.url }}">{{ post.title or (post.publishedAt | postDate) }}</a></h1>
    <time class="blog-post-date" datetime="{{ post.publishedAt | postDateISO }}">{{ post.publishedAt | postDate }}</time>
    <div class="blog-post-body">{{ post.bodyHtml | safe }}</div>
  </article>
  <a href="/blog/" class="blog-back-link">&larr; Back to blog</a>
</div>
