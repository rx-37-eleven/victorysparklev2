---
layout: base.njk
title: Travel Map
description: An interactive map of every place I've visited, lived in, or have plans to see.
permalink: /map/
---
{% import "region-map.njk" as regionMap %}
<div class="content-section travel-map-page">
  <h1>Where I've Been</h1>

  <section class="travel-map-section" data-region="us">
    <h2>United States</h2>
    <div class="travel-map-wrap">
      {% include "us-map.svg" %}
    </div>
    <ul class="map-legend">
      {% for key, entry in travelmap.legend %}
      <li class="map-legend-row" data-status="{{ key }}" tabindex="0" role="button">
        <span class="map-legend-swatch" style="background-color: {{ entry.color }};"></span>
        <span class="map-legend-label">{{ entry.label }}</span>
        <span class="map-legend-count">{{ legendCounts.us[key] }}</span>
      </li>
      {% endfor %}
    </ul>
  </section>

  {% for regionKey, region in regionMaps %}
  {% if regionKey != "_comment" %}
  <section class="travel-map-section" data-region="{{ regionKey }}">
    <h2>{{ region.label }}</h2>
    <div class="travel-map-wrap">
      {{ regionMap.render(regionKey, region, mapRender.regions[regionKey]) }}
    </div>
    <ul class="map-legend">
      {% for key, entry in travelmap.legend %}
      <li class="map-legend-row" data-status="{{ key }}" tabindex="0" role="button">
        <span class="map-legend-swatch" style="background-color: {{ entry.color }};"></span>
        <span class="map-legend-label">{{ entry.label }}</span>
        <span class="map-legend-count">{{ legendCounts[regionKey][key] }}</span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
  {% endfor %}

  <div class="map-tooltip" id="map-tooltip" hidden></div>
</div>

<script src="/js/map.js" defer></script>
